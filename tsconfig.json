{
	"compilerOptions": {
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"jsx": "react-jsx",
		"target": "ESNext",
		"module": "Preserve",
		"moduleDetection": "force",
		"allowJs": true,

		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,

		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noPropertyAccessFromIndexSignature": false,
		"types": ["bun"],
		"paths": {
			"@mxd/auth-context": ["./web/auth-context.ts"],
			"@mxd/types": ["./web/runtime-types.ts"]
		}
	},
	// scripts/retrieval-exp is a self-contained experiment spike with its own
	// package.json (deps not installed in fresh checkouts/worktrees) — exclude
	// it from the product typecheck gate.
	"exclude": [".worktrees", "scripts/retrieval-exp"]
}
