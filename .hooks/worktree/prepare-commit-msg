#!/bin/sh
#
# Attach `Task-Id: <id>` as a git trailer to every commit made inside an agent
# worktree, so a line of code can be traced back to the task that wrote it.
#
# WHY a trailer and not the subject line: the subject is the one field a human
# (or agent) wants to write well, and `git merge -m "<a good sentence>"`
# overwrites git's default `Merge branch 'mxd/<taskId>/…'`. That is how the link
# died in 92% of this repo's merge commits — the more carefully you write, the
# more reliably the id is gone. A trailer does not compete for that field.
#
# WHY every commit and not just the merge: `git blame` lands on non-merge
# commits, because a clean merge carries no changes. An id living only on merge
# commits is an id for a commit nobody is holding.
#
# The id comes from `mxd.taskId` in git config, written per-worktree by
# WorktreeManager at creation time. Deliberately NOT parsed out of the worktree
# path: the path shape is an implementation detail that has changed before, and
# git config is the durable place to record a worktree's identity.
#
# Installed by .mxd/hooks/setup_worktree.sh, which points core.hooksPath at THIS
# directory — holding prepare-commit-msg and nothing else. Worktrees deliberately
# skip .hooks/pre-commit: agents commit very frequently and that gate runs
# typecheck plus a test subset. Recording provenance must not become gating.
#
# This hook NEVER fails the commit. A non-zero exit from prepare-commit-msg
# aborts the commit, i.e. a bug in here would take away the one thing an agent
# needs in order to fix it. Failures warn on stderr and exit 0.

msg_file="$1"
[ -n "$msg_file" ] || exit 0
[ -f "$msg_file" ] || exit 0

task_id=$(git config --get mxd.taskId 2>/dev/null) || task_id=""
[ -n "$task_id" ] || exit 0

# Do nothing when the message is empty (only blanks and comments). git aborts
# such a commit; adding a trailer would make it non-empty and commit anyway,
# with the trailer as the subject line. Measured, not hypothetical.
if ! grep -qv -e '^[[:space:]]*#' -e '^[[:space:]]*$' "$msg_file"; then
	exit 0
fi

# The newline guard below and --no-divider on the call are ONE fact wearing two
# faces: interpret-trailers has its own opinion about where a commit message
# ENDS, and it does not match the reader's. Any time it places the trailer
# somewhere that is not the last paragraph as `%(trailers:…)` sees it, the id
# sits in `%B` looking perfect while the parser reports nothing at all. If you
# are here adding a third guard, that is the thing to go looking for.
#
# MERGE_MSG arrives with NO trailing newline (measured, git 2.44), unlike
# COMMIT_EDITMSG. interpret-trailers then joins the trailer to the subject with
# a single newline instead of a blank line, and git's own trailer parser cannot
# read that back — `%(trailers:key=Task-Id)` returns empty. So every merge made
# inside a worktree would carry an unreadable id.
if [ -n "$(tail -c1 "$msg_file")" ]; then
	printf '\n' >>"$msg_file"
fi

# --if-exists doNothing is what makes this idempotent, which --amend needs.
#
# --no-divider: a line of `---` is the format-patch divider (there it precedes
# the diffstat), and interpret-trailers stops the message at it, inserting the
# trailer BEFORE it. The asymmetry is the whole mechanism — only the WRITER
# honours `---`; the reader simply takes the last paragraph, so a trailer parked
# above the divider stops being a trailer. Measured on a real commit: without
# this flag any message using a horizontal rule loses its id.
if ! git interpret-trailers --no-divider --if-exists doNothing \
	--trailer "Task-Id: $task_id" --in-place "$msg_file" 2>/dev/null; then
	echo "prepare-commit-msg: failed to attach Task-Id: $task_id" >&2
fi

# Verify our own work. Three separate causes have already parked the trailer
# somewhere the reader cannot see it, and all three were SILENT — the id sat in
# `%B` looking perfect. This is the detector for the fourth.
#
# `--no-divider --parse` applies git's OWN last-paragraph rule to the pending
# message, so this is not a second reader implementation — it is the same code
# asked at hook time. Measured to agree with `%(trailers:key=Task-Id,valueonly)`
# on the resulting commit for 11 of 11 shapes, including the divider damage, its
# fix, and messages trailed by comment or scissors blocks (which would otherwise
# warn spuriously on the editor path).
#
# WARN, never fail. This is the last moment the author can still fix it with
# `--amend`, and a gate here could not be satisfied by doing the right thing:
# the damage it would report is in a commit that already exists.
if ! git interpret-trailers --no-divider --parse "$msg_file" 2>/dev/null |
	grep -q '^Task-Id:'; then
	echo "prepare-commit-msg: Task-Id: $task_id is in the message but will NOT" \
		"read back — git takes the trailer block from the LAST paragraph, and" \
		"something else is there. Amend so the message ends with the trailer." >&2
fi

exit 0
