#!/bin/sh
# Pre-commit hook: enforces typecheck, lint, i18n and a test SMOKE SUBSET.
# Install: git config core.hooksPath .hooks
#
# The test step is a subset on purpose. A full `bun test` is ~260-300s, which is
# unusable per commit — performance is the one legitimate reason to enumerate
# what to run instead of starting from everything and subtracting. That licenses
# the narrow scope; it does not license an unqualified "All checks passed."
# So both numbers below are COMPUTED and printed: a re-narrowing of this list, or
# a suite that grows around it, lands in the terminal of whoever commits next.

set -e

# Strip git env vars so test subprocesses (git init, worktree ops) work correctly
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

SMOKE_TESTS="
src/daemon.test.ts
src/project-manager.test.ts
src/task-tracker.test.ts
src/worktree-manager.test.ts
src/event-store.test.ts
src/events.test.ts
src/data-paths.test.ts
src/check-i18n.test.ts
src/pre-commit-hook.test.ts
"

# `bun test` skips a path that does not exist and still exits 0, so a file
# deleted out from under this list leaves no trace at all. This list named
# `src/direct-provider.test.ts` for four months after it was deleted, and ran
# four files while claiming five. Make the drain loud.
missing=""
for f in $SMOKE_TESTS; do
	[ -f "$f" ] || missing="$missing $f"
done
if [ -n "$missing" ]; then
	echo "pre-commit FAILED — named here but not on disk:$missing"
	echo "A missing path is skipped silently by 'bun test', so this list would"
	echo "keep shrinking without a word. Fix the list in $0."
	exit 1
fi

RAN=$(echo $SMOKE_TESTS | wc -w | tr -d ' ')
TOTAL=$(git ls-files '*.test.ts' '*.test.tsx' | wc -l | tr -d ' ')

echo "Running typecheck..."
bun run typecheck

echo "Running lint..."
bun run check:ci

echo "Running i18n check..."
bash scripts/check-i18n.sh

echo "Running tests ($RAN of $TOTAL test files)..."
bun test --bail $SMOKE_TESTS

echo "All checks passed — typecheck, lint, i18n, and $RAN of $TOTAL test files (a smoke subset, NOT the suite)."
